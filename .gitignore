# Secrets — never commit (law-enforcement deployment)
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Celery beat scheduler state (generated at runtime)
celerybeat-schedule
celerybeat-schedule.*

# Node
node_modules/
dist/
*.local

# Data / evidence (must live in MinIO/WORM, never in git)
data/
*.mp4
*.bin

# Secrets — login cookies / session files (credentials, NEVER in git)
secrets/
**/secrets/
*cookies*.txt

# DB snapshots (contain user TOTP secrets / password hashes — keep out of git)
snapshots/
**/snapshots/
*.sql.dump
