# Copy to .env. NEVER commit real secrets — this is a law-enforcement deployment.
# Postgres
POSTGRES_USER=afm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=afm
DATABASE_URL=postgresql+psycopg://afm:change_me@postgres:5432/afm

# Neo4j (Fraud Graph)
NEO4J_PASSWORD=change_me
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# Qdrant (Scam Fingerprint vectors)
QDRANT_URL=http://qdrant:6333

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0

# MinIO (evidence / chain of custody)
MINIO_ENDPOINT=minio:9000
MINIO_USER=afm
MINIO_PASSWORD=change_me
MINIO_RAW_BUCKET=raw
MINIO_EVIDENCE_BUCKET=evidence

# Temporal (AI Investigator workflows)
TEMPORAL_HOST=temporal:7233

# --- AI provider ---------------------------------------------------------------
# openai | anthropic | local. Prototype default = openai (no local GPU yet).
# RULE: only synthetic/demo data through external APIs.
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai; also handles embeddings/STT/vision for anthropic)
OPENAI_API_KEY=sk-replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_STT_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o

# Anthropic (only when AI_PROVIDER=anthropic — chat/narrative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Self-hosted LLM (production target, AI_PROVIDER=local) — on-prem, no external calls
LLM_BASE_URL=http://vllm:8001/v1
LLM_MODEL=Qwen2.5-72B-Instruct

# --- Collectors (social video) -------------------------------------------------
# TikTok/Instagram block anonymous datacenter requests -> a logged-in session is
# required to fetch their videos. Paste the raw `Cookie:` header from a browser
# logged into a (test) account. Empty = those links fail with an actionable hint.
# Authorized testing only (ToS / prototype rule — see ADR-0005).
TIKTOK_COOKIE=
INSTAGRAM_COOKIE=
# Alternatively, a path to a Netscape cookies.txt for Instagram (takes priority):
INSTAGRAM_COOKIES_FILE=

# --- Money Flow (on-chain) -----------------------------------------------------
# Public blockchain tracing wallet -> exchange. Empty key = stub (flow stops at
# the wallet). Set a key to enable real Etherscan lookups. Public chain only —
# never bank rails (that boundary stays the agency's data).
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ONCHAIN_COUNTERPARTY_LIMIT=50

# --- License registry ----------------------------------------------------------
# Operators verified as licensed. Allowlist (offline) always overrides the API.
# Empty API url = allowlist-only (prototype). Set it for live regulator lookups.
# LICENSED_REGISTRY is JSON: ["profit-x.com","@legalbroker"]
LICENSED_REGISTRY=[]
LICENSE_REGISTRY_API_URL=
LICENSE_REGISTRY_API_KEY=

# Auth / RBAC
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
